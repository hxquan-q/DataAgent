<?xml version="1.0" encoding="UTF-8"?>
<!--
  IDEA / 命令行共用：本地仓库指向项目内 .m2-local（可写）。
  原因：本机 ~/.m2 属 root，ubuntu 用户无写权限 → IDEA Maven 导入/下载依赖失败。

  IDEA：Settings → Build → Build Tools → Maven → User settings file
        勾选 Override，选本文件路径。
  CLI： mvn -s maven-settings-local.xml ...
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <!-- 使用绝对路径，避免 IDEA 工作目录不同导致找不到仓库 -->
  <localRepository>/home/ubuntu/spingagent/DataAgent/.m2-local/repository</localRepository>

  <mirrors>
    <!-- 可选：网络慢时取消注释用阿里云 -->
    <!--
    <mirror>
      <id>aliyun-central</id>
      <mirrorOf>central</mirrorOf>
      <name>Aliyun Maven</name>
      <url>https://maven.aliyun.com/repository/central</url>
    </mirror>
    -->
  </mirrors>
</settings>
