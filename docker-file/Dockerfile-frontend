# 构建阶段
FROM node:22-alpine AS builder

WORKDIR /app

# 使用项目约定的 pnpm 构建 Nuxt 4 前端
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

# Docker 构建环境网络较慢时，使用镜像源并提高下载容错。
RUN pnpm config set registry https://registry.npmmirror.com \
	&& pnpm config set fetch-retries 5 \
	&& pnpm config set fetch-timeout 600000 \
	&& pnpm config set fetch-retry-mintimeout 10000 \
	&& pnpm config set fetch-retry-maxtimeout 120000

COPY data-agent-frontend-nuxt/package.json data-agent-frontend-nuxt/pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile --ignore-scripts

COPY data-agent-frontend-nuxt ./

# 生成可由 Nginx 静态托管的 SPA 产物
RUN pnpm exec nuxt prepare && pnpm generate


# 运行阶段
FROM nginx:alpine

# 复制构建结果到nginx目录
COPY --from=builder /app/.output/public /usr/share/nginx/html

# 暴露端口
EXPOSE 3301

# 启动nginx
CMD ["nginx", "-g", "daemon off;"]
